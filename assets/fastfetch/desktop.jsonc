// fastfetch layout for the desktop terminal in the Laser Flow wallpaper
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "kali", "padding": { "top": 0, "right": 3 } },
  "display": { "color": { "keys": "blue", "title": "blue" }, "separator": ": " },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "de", "wm", "theme", "icons", "terminal", "cpu", "gpu", "memory", "swap",
    { "type": "disk", "folders": "/" },
    "localip", "battery", "break", "colors"
  ]
}
