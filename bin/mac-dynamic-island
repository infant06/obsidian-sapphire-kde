#!/usr/bin/env python3
"""
Obsidian & Sapphire Dynamic Island for KDE Plasma (Universal Plasma 5 & 6 Edition)
Cohesive Luxury Dark UI • X11-Safe Zero-Freeze Architecture
"""

import glob
import math
import os
import shutil
import subprocess
import sys
import time
from PyQt6.QtCore import (
    QPoint,
    QRect,
    QRectF,
    Qt,
    QThread,
    QTimer,
    pyqtSignal,
)
from PyQt6.QtGui import (
    QColor,
    QCursor,
    QFont,
    QGuiApplication,
    QLinearGradient,
    QPainter,
    QPainterPath,
    QPen,
)
from PyQt6.QtWidgets import (
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QSlider,
    QVBoxLayout,
    QWidget,
)

SIDEBAR_TOGGLE_FILE = f"/tmp/mac-side-monitor-toggle-{os.getuid()}"
LAUNCHER_TOGGLE_FILE = f"/tmp/mac-app-launcher-toggle-{os.getuid()}"
QDBUS_BIN = (
    shutil.which("qdbus6")
    or shutil.which("qdbus")
    or shutil.which("qdbus-qt5")
    or "qdbus6"
)


def run_cmd(cmd_list, timeout=1.2):
    try:
        res = subprocess.run(
            cmd_list,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
        return res.stdout.strip()
    except Exception:
        return ""


def read_sys_file(path):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return ""


class TelemetryWorker(QThread):
    updated = pyqtSignal(dict)

    def __init__(self):
        super().__init__()
        self._running = True

    def get_battery(self):
        for bat_dir in sorted(glob.glob("/sys/class/power_supply/BAT*")):
            cap = read_sys_file(os.path.join(bat_dir, "capacity"))
            status = read_sys_file(os.path.join(bat_dir, "status"))
            if cap:
                try:
                    return int(cap), status or "Discharging"
                except ValueError:
                    pass
        return 100, "AC"

    def get_cpu_temp(self):
        for hw in glob.glob("/sys/class/hwmon/hwmon*"):
            name = read_sys_file(os.path.join(hw, "name"))
            if name in ("k10temp", "coretemp", "zenpower", "cpu_thermal", "acpitz", "acpitz_0"):
                t = read_sys_file(os.path.join(hw, "temp1_input"))
                if t:
                    try:
                        return round(int(t) / 1000.0)
                    except ValueError:
                        pass
        for tz in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
            raw = read_sys_file(tz)
            if raw:
                try:
                    val = int(raw) / 1000.0
                    if 15.0 < val < 115.0:
                        return round(val)
                except ValueError:
                    pass
        return 45

    def get_mpris(self):
        out = run_cmd([QDBUS_BIN])
        services = [
            line.strip()
            for line in out.splitlines()
            if "org.mpris.MediaPlayer2." in line
        ]
        if not services:
            return {
                "playing": False,
                "title": "No Media Playing",
                "artist": "System Ready",
                "service": "",
            }
        first_srv = services[0]
        status = run_cmd(
            [
                QDBUS_BIN,
                first_srv,
                "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2.Player.PlaybackStatus",
            ]
        )
        meta = run_cmd(
            [
                QDBUS_BIN,
                first_srv,
                "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2.Player.Metadata",
            ]
        )
        title = ""
        artist = ""
        for line in meta.splitlines():
            if "xesam:title:" in line:
                title = line.split("xesam:title:", 1)[1].strip()
            elif "xesam:artist:" in line:
                artist = line.split("xesam:artist:", 1)[1].strip()
        is_playing = status.lower() == "playing"
        if not title:
            title = "Media Active" if is_playing else "Media Paused"
        if not artist:
            artist = first_srv.replace("org.mpris.MediaPlayer2.", "").capitalize()
        return {
            "playing": is_playing,
            "title": title[:34],
            "artist": artist[:28],
            "service": first_srv,
        }

    def get_volume(self):
        out = run_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        if out and "Volume:" in out:
            try:
                val = float(out.split("Volume:")[1].split()[0])
                return int(round(val * 100))
            except Exception:
                pass
        return 65

    def get_brightness(self):
        out = run_cmd(
            [
                QDBUS_BIN,
                "org.kde.Solid.PowerManagement",
                "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "brightness",
            ]
        )
        max_out = run_cmd(
            [
                QDBUS_BIN,
                "org.kde.Solid.PowerManagement",
                "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "brightnessMax",
            ]
        )
        try:
            b = int(out)
            m = int(max_out)
            if m > 0:
                return int(round((b / m) * 100)), m
        except Exception:
            pass
        return 80, 100

    def run(self):
        while self._running:
            bat_pct, bat_status = self.get_battery()
            cpu_temp = self.get_cpu_temp()
            mpris = self.get_mpris()
            vol = self.get_volume()
            bri, bri_max = self.get_brightness()
            self.updated.emit(
                {
                    "bat_pct": bat_pct,
                    "bat_status": bat_status,
                    "cpu_temp": cpu_temp,
                    "mpris": mpris,
                    "volume": vol,
                    "brightness": bri,
                    "brightness_max": bri_max,
                }
            )
            time.sleep(2.0)


class DynamicIsland(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Obsidian Dynamic Island")
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint
            | Qt.WindowType.WindowStaysOnTopHint
            | Qt.WindowType.Tool
            | Qt.WindowType.WindowDoesNotAcceptFocus
        )
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating, True)
        self.setMouseTracking(True)

        screen = QGuiApplication.primaryScreen().geometry()
        self.screen_w = screen.width()
        self.top_y = 3

        self.compact_w = 248
        self.compact_h = 28
        self.expanded_w = 446
        self.expanded_h = 222

        self.expanded = False
        self.pinned_open = False
        self.wave_phase = 0.0
        self.toast_text = ""
        self.toast_until = 0.0

        self.state = {
            "bat_pct": 100,
            "bat_status": "AC",
            "cpu_temp": 48,
            "mpris": {
                "playing": False,
                "title": "No Media Playing",
                "artist": "System Ready",
                "service": "",
            },
            "volume": 70,
            "brightness": 80,
            "brightness_max": 100,
        }

        self._build_expanded_ui()
        self._apply_box(self.compact_w, self.compact_h)

        self.wave_timer = QTimer(self)
        self.wave_timer.timeout.connect(self._tick_wave)

        self.collapse_timer = QTimer(self)
        self.collapse_timer.setSingleShot(True)
        self.collapse_timer.timeout.connect(self._check_mouse_leave)

        self.worker = TelemetryWorker()
        self.worker.updated.connect(self._on_telemetry)
        self.worker.start()

    def _build_expanded_ui(self):
        self.content = QWidget(self)
        self.content.setGeometry(0, 0, self.expanded_w, self.expanded_h)
        self.content.setVisible(False)

        layout = QVBoxLayout(self.content)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.setSpacing(10)

        top_row = QHBoxLayout()
        self.lbl_status = QLabel("● CONTROL ISLAND")
        self.lbl_status.setStyleSheet(
            "color: #60A5FA; font-size: 10px; font-weight: 800; letter-spacing: 0.8px;"
        )
        self.lbl_meta_right = QLabel("CPU 48°C   •   BAT 100%")
        self.lbl_meta_right.setStyleSheet(
            "color: #94A3B8; font-size: 10px; font-weight: 700; background: #161B2B; border: 1px solid #262F48; border-radius: 8px; padding: 2px 8px;"
        )
        top_row.addWidget(self.lbl_status)
        top_row.addStretch()
        top_row.addWidget(self.lbl_meta_right)
        layout.addLayout(top_row)

        media_card = QFrame()
        media_card.setStyleSheet(
            """
            QFrame {
                background-color: #151A29;
                border: 1px solid #242D46;
                border-radius: 13px;
            }
            """
        )
        media_row = QHBoxLayout(media_card)
        media_row.setContentsMargins(12, 8, 12, 8)
        media_row.setSpacing(10)

        badge = QLabel("♫")
        badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        badge.setFixedSize(34, 34)
        badge.setStyleSheet(
            "background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3B82F6, stop:1 #4F46E5); color: #FFFFFF; border-radius: 10px; font-size: 15px; font-weight: bold; border: none;"
        )
        media_row.addWidget(badge)

        media_info = QVBoxLayout()
        media_info.setSpacing(1)
        self.lbl_track = QLabel("Obsidian Desktop")
        self.lbl_track.setStyleSheet(
            "color: #F8FAFC; font-size: 12px; font-weight: 700; border: none; background: transparent;"
        )
        self.lbl_artist = QLabel("Quick Controls & Media Hub")
        self.lbl_artist.setStyleSheet(
            "color: #94A3B8; font-size: 10px; font-weight: 500; border: none; background: transparent;"
        )
        media_info.addWidget(self.lbl_track)
        media_info.addWidget(self.lbl_artist)
        media_row.addLayout(media_info)
        media_row.addStretch()

        btn_style = """
            QPushButton {
                background-color: #1E253A;
                color: #F8FAFC;
                border: 1px solid #2E3856;
                border-radius: 14px;
                font-size: 11px;
                font-weight: bold;
                min-width: 28px;
                max-width: 28px;
                min-height: 28px;
                max-height: 28px;
            }
            QPushButton:hover {
                background-color: #3B82F6;
                border: 1px solid #60A5FA;
            }
        """
        for sym, method in [("⏮", "Previous"), ("⏯", "PlayPause"), ("⏭", "Next")]:
            b = QPushButton(sym)
            b.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.setStyleSheet(btn_style)
            b.clicked.connect(lambda checked, m=method: self._mpris_cmd(m))
            media_row.addWidget(b)

        layout.addWidget(media_card)

        slider_style = """
            QSlider::groove:horizontal {
                height: 6px;
                background: #1B2234;
                border: 1px solid #28324C;
                border-radius: 3px;
            }
            QSlider::sub-page:horizontal {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3B82F6, stop:1 #6366F1);
                border-radius: 3px;
            }
            QSlider::handle:horizontal {
                background: #F8FAFC;
                border: 1px solid #3B82F6;
                width: 12px;
                margin: -4px 0;
                border-radius: 6px;
            }
        """
        sliders_row = QHBoxLayout()
        sliders_row.setSpacing(10)

        lbl_vol = QLabel("VOL")
        lbl_vol.setStyleSheet("color: #94A3B8; font-size: 9px; font-weight: 800;")
        self.slider_vol = QSlider(Qt.Orientation.Horizontal)
        self.slider_vol.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.slider_vol.setRange(0, 100)
        self.slider_vol.setValue(70)
        self.slider_vol.setStyleSheet(slider_style)
        self.slider_vol.sliderReleased.connect(self._set_volume)
        self.lbl_vol_val = QLabel("70%")
        self.lbl_vol_val.setFixedWidth(28)
        self.lbl_vol_val.setStyleSheet("color: #E2E8F0; font-size: 10px; font-weight: 700;")

        lbl_bri = QLabel("BRI")
        lbl_bri.setStyleSheet("color: #94A3B8; font-size: 9px; font-weight: 800;")
        self.slider_bri = QSlider(Qt.Orientation.Horizontal)
        self.slider_bri.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.slider_bri.setRange(10, 100)
        self.slider_bri.setValue(80)
        self.slider_bri.setStyleSheet(slider_style)
        self.slider_bri.sliderReleased.connect(self._set_brightness)
        self.lbl_bri_val = QLabel("80%")
        self.lbl_bri_val.setFixedWidth(28)
        self.lbl_bri_val.setStyleSheet("color: #E2E8F0; font-size: 10px; font-weight: 700;")

        sliders_row.addWidget(lbl_vol)
        sliders_row.addWidget(self.slider_vol)
        sliders_row.addWidget(self.lbl_vol_val)
        sliders_row.addSpacing(6)
        sliders_row.addWidget(lbl_bri)
        sliders_row.addWidget(self.slider_bri)
        sliders_row.addWidget(self.lbl_bri_val)
        layout.addLayout(sliders_row)

        actions_row = QHBoxLayout()
        actions_row.setSpacing(8)
        pill_style = """
            QPushButton {
                background-color: #161B2B;
                color: #F8FAFC;
                border: 1px solid #262F48;
                border-radius: 10px;
                padding: 6px 8px;
                font-size: 11px;
                font-weight: 600;
            }
            QPushButton:hover {
                background-color: #2563EB;
                border: 1px solid #60A5FA;
            }
        """
        for label, handler in [
            ("❖  All Apps", self._toggle_launcher),
            ("▤  Monitor", self._toggle_sidebar),
            ("⚡  Boost", self._trigger_speed_boost),
            ("⎙  Capture", self._trigger_screenshot),
        ]:
            btn = QPushButton(label)
            btn.setFocusPolicy(Qt.FocusPolicy.NoFocus)
            btn.setCursor(Qt.CursorShape.PointingHandCursor)
            btn.setStyleSheet(pill_style)
            btn.clicked.connect(handler)
            actions_row.addWidget(btn)

        layout.addLayout(actions_row)

    def show_toast(self, msg, duration=2.2):
        self.toast_text = msg
        self.toast_until = time.time() + duration
        self.lbl_status.setText(f"● {msg.upper()}")
        self.update()

    def _mpris_cmd(self, method):
        srv = self.state["mpris"].get("service")
        if srv:
            subprocess.Popen(
                [
                    QDBUS_BIN,
                    srv,
                    "/org/mpris/MediaPlayer2",
                    f"org.mpris.MediaPlayer2.Player.{method}",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.show_toast(f"Media {method}", 1.4)
        else:
            self.show_toast("No Active Player", 1.8)

    def _set_volume(self):
        v = self.slider_vol.value()
        self.lbl_vol_val.setText(f"{v}%")
        subprocess.Popen(
            ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v}%"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.show_toast(f"Volume {v}%", 1.4)

    def _set_brightness(self):
        pct = self.slider_bri.value()
        self.lbl_bri_val.setText(f"{pct}%")
        b_max = self.state.get("brightness_max", 100)
        target = str(int((pct / 100.0) * b_max))
        subprocess.Popen(
            [
                QDBUS_BIN,
                "org.kde.Solid.PowerManagement",
                "/org/kde/Solid/PowerManagement/Actions/BrightnessControl",
                "setBrightness",
                target,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.show_toast(f"Brightness {pct}%", 1.4)

    def _trigger_speed_boost(self):
        boost_bin = os.path.expanduser("~/.local/bin/mac-speed-boost")
        subprocess.Popen(
            [boost_bin, "--quick"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.show_toast("Speed Boost Applied", 2.2)

    def _trigger_screenshot(self):
        subprocess.Popen(
            ["spectacle", "-b", "-n"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.show_toast("Screen Captured", 2.0)

    def _toggle_sidebar(self):
        try:
            with open(SIDEBAR_TOGGLE_FILE, "w") as f:
                f.write("1")
            self.show_toast("Monitor Bar Toggled", 1.6)
        except Exception:
            pass

    def _toggle_launcher(self):
        try:
            with open(LAUNCHER_TOGGLE_FILE, "w") as f:
                f.write("1")
            self.collapse_island()
        except Exception:
            pass

    def _on_telemetry(self, data):
        self.state = data
        now_str = time.strftime("%H:%M")
        playing = data["mpris"]["playing"]

        if playing and not self.wave_timer.isActive():
            self.wave_timer.start(90)
        elif not playing and self.wave_timer.isActive():
            self.wave_timer.stop()

        if time.time() > self.toast_until:
            if playing:
                self.lbl_status.setText("● NOW PLAYING")
            else:
                self.lbl_status.setText(f"● CONTROL ISLAND  •  {now_str}")

        self.lbl_meta_right.setText(
            f"CPU {data['cpu_temp']}°C   •   BAT {data['bat_pct']}%"
        )
        if playing:
            self.lbl_track.setText(data["mpris"]["title"])
            self.lbl_artist.setText(data["mpris"]["artist"])
        else:
            self.lbl_track.setText("Obsidian Control Hub")
            self.lbl_artist.setText("System Ready  •  Hover or Click")

        if not self.slider_vol.isSliderDown():
            self.slider_vol.setValue(data["volume"])
            self.lbl_vol_val.setText(f"{data['volume']}%")
        if not self.slider_bri.isSliderDown():
            self.slider_bri.setValue(data["brightness"])
            self.lbl_bri_val.setText(f"{data['brightness']}%")

        if not self.expanded:
            target_w = 292 if playing else self.compact_w
            if self.width() != target_w:
                self._apply_box(target_w, self.compact_h)
        self.update()

    def _tick_wave(self):
        self.wave_phase += 0.35
        if not self.expanded:
            self.update()

    def _apply_box(self, w, h):
        x = (self.screen_w - w) // 2
        self.setGeometry(x, self.top_y, w, h)
        self.update()

    def expand_island(self):
        if self.expanded:
            return
        self.expanded = True
        self._apply_box(self.expanded_w, self.expanded_h)
        self.content.setVisible(True)

    def collapse_island(self):
        if not self.expanded or self.pinned_open:
            return
        self.expanded = False
        self.content.setVisible(False)
        target_w = 292 if self.state["mpris"]["playing"] else self.compact_w
        self._apply_box(target_w, self.compact_h)

    def enterEvent(self, event):
        self.collapse_timer.stop()
        self.expand_island()
        super().enterEvent(event)

    def leaveEvent(self, event):
        self.collapse_timer.start(320)
        super().leaveEvent(event)

    def _check_mouse_leave(self):
        pos = QCursor.pos()
        if not self.geometry().adjusted(-10, -10, 10, 10).contains(pos):
            self.collapse_island()
        else:
            self.collapse_timer.start(280)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            if not self.expanded:
                self.expand_island()
            else:
                self.pinned_open = not self.pinned_open
                self.show_toast(
                    "Island Pinned" if self.pinned_open else "Auto-Hide Active", 1.5
                )

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)

        rect = QRectF(1.0, 1.0, self.width() - 2.0, self.height() - 2.0)
        radius = 20.0 if self.expanded else (self.height() / 2.0)

        path = QPainterPath()
        path.addRoundedRect(rect, radius, radius)

        grad = QLinearGradient(0, 0, 0, self.height())
        grad.setColorAt(0.0, QColor(15, 18, 29, 248))
        grad.setColorAt(1.0, QColor(9, 11, 18, 252))
        painter.fillPath(path, grad)

        pen = QPen(QColor(96, 165, 250, 58), 1.1)
        painter.setPen(pen)
        painter.drawPath(path)

        if not self.expanded:
            lens_x = 14
            lens_y = self.height() // 2
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(37, 99, 235, 65))
            painter.drawEllipse(QPoint(lens_x + 4, lens_y), 6, 6)
            painter.setBrush(QColor(96, 165, 250))
            painter.drawEllipse(QPoint(lens_x + 4, lens_y), 3, 3)

            font = QFont("Noto Sans", 9, QFont.Weight.DemiBold)
            painter.setFont(font)
            painter.setPen(QColor(248, 250, 252, 238))
            if time.time() < self.toast_until:
                center_txt = self.toast_text
            elif self.state["mpris"]["playing"]:
                center_txt = f"♫  {self.state['mpris']['title'][:20]}"
            else:
                center_txt = f"{time.strftime('%H:%M')}   •   CPU {self.state['cpu_temp']}°C"

            painter.drawText(
                QRect(32, 0, self.width() - 72, self.height()),
                Qt.AlignmentFlag.AlignCenter,
                center_txt,
            )

            base_x = self.width() - 34
            mid_y = self.height() / 2.0
            for i in range(4):
                amp = 7.0 if self.state["mpris"]["playing"] else 2.2
                h_bar = max(3.0, abs(math.sin(self.wave_phase + i * 0.9)) * amp + 2.5)
                bar_color = (
                    QColor(96, 165, 250)
                    if self.state["mpris"]["playing"]
                    else QColor(148, 163, 184, 140)
                )
                painter.setBrush(bar_color)
                painter.drawRoundedRect(
                    QRectF(base_x + i * 4.8, mid_y - h_bar / 2.0, 2.5, h_bar),
                    1.2,
                    1.2,
                )


def main():
    app = QApplication(sys.argv)
    island = DynamicIsland()
    island.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
