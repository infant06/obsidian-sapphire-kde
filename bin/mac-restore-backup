#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="$HOME/.config/kde-backup-pre-mac"
QDBUS=$(command -v qdbus6 || command -v qdbus || command -v qdbus-qt5 || echo "qdbus6")

echo "Restoring original KDE configuration from $BACKUP_DIR..."

systemctl --user disable --now mac-dynamic-island.service mac-side-monitor.service mac-app-launcher.service 2>/dev/null || true

for f in kdeglobals kwinrc plasmarc plasma-org.kde.plasma.desktop-appletsrc klaunchrc krunnerrc kscreenlockerrc baloofilerc; do
    if [ -f "$BACKUP_DIR/$f.bak" ]; then
        cp -a "$BACKUP_DIR/$f.bak" "$HOME/.config/$f"
    fi
done

"$QDBUS" org.kde.KWin /KWin reconfigure 2>/dev/null || true
systemctl --user restart plasma-plasmashell.service 2>/dev/null || true
echo "✅ Original KDE configuration restored!"
