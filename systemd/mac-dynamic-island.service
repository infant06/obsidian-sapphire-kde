[Unit]
Description=Obsidian & Sapphire Dynamic Island for KDE Plasma
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mac-dynamic-island
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target default.target
