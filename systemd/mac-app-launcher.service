[Unit]
Description=Obsidian & Sapphire Floating Centered App Launcher
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mac-app-launcher
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target default.target
